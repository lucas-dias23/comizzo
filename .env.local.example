# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AbacatePay — app.abacatepay.com (Configurações > API / Produtos / Webhooks)
ABACATEPAY_API_KEY=
# IDs dos produtos de assinatura (prod_...), não o preço em centavos
ABACATEPAY_PRODUCT_MONTHLY=
ABACATEPAY_PRODUCT_YEARLY=
# Segredo que você mesmo escolhe e cola na URL do webhook como
# ?webhookSecret=... no painel do AbacatePay — é a única verificação de
# origem do webhook por enquanto (ver TODO em app/api/webhooks/abacatepay/route.ts)
ABACATEPAY_WEBHOOK_SECRET=

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mercado Livre Developers — opcional. Sem isso, o sistema usa dados mock.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Protege /api/cron/refresh-products. Gere uma string aleatória e cole
# o mesmo valor na env var CRON_SECRET do projeto na Vercel.
CRON_SECRET=
